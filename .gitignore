# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.env
.venv
venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# IDE & OS
.vscode/
.idea/
.DS_Store
*.swp
*~

# Large data files
data/*
!data/.gitkeep
# ...but keep the calibrate baseline and the measured evaluation output, since
# they are the evidence behind docs/results.md.
!data/baseline.json
!data/evaluation/
!data/evaluation/**
